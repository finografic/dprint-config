{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "json": {
    // If arrays and objects should collapse to a single line if it would be below the line width. | Allowed values: true, false | Default: false
    "array.preferSingleLine": false,
    // Forces a space after slashes.  For example: `// comment` instead of `//comment` | Allowed values: true, false | Default: true
    "commentLine.forceSpaceAfterSlashes": true,
    // Top level configuration that sets the configuration to what is used in Deno. | Allowed values: true, false | Default: false
    "deno": false,
    // The text to use for an ignore comment (ex. `// dprint-ignore`). | Default: "dprint-ignore"
    "ignoreNodeCommentText": "dprint-ignore",
    // The number of characters for an indent. | Default: 2
    "indentWidth": 2,
    // The width of a line the printer will try to stay under. Note that the printer may exceed this width in certain cases. | Default: 120
    "lineWidth": 120,
    // The kind of newline to use. | Allowed values: "auto", "crlf", "lf", "system" | Default: "lf"
    "newLineKind": "lf",
    // If arrays and objects should collapse to a single line if it would be below the line width. | Allowed values: true, false | Default: false
    "object.preferSingleLine": false,
    // If arrays and objects should collapse to a single line if it would be below the line width. | Allowed values: true, false | Default: false
    "preferSingleLine": false,
    // Whether to use trailing commas. | Allowed values: "always", "jsonc", "maintain", "never" | Default: "jsonc"
    "trailingCommas": "jsonc",
    // Whether to use tabs (true) or spaces (false). | Allowed values: true, false | Default: false
    "useTabs": false
  },
}
