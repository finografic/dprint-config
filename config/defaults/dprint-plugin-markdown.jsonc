{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "markdown": {
    // Top level configuration that sets the configuration to what is used in Deno. | Allowed values: true, false | Default: false
    "deno": false,
    // The character to use for emphasis/italics. | Allowed values: "asterisks", "underscores" | Default: "underscores"
    "emphasisKind": "underscores",
    // The text to use for an ignore directive (ex. `<!-- dprint-ignore -->`). | Default: "dprint-ignore"
    "ignoreDirective": "dprint-ignore",
    // The text to use for an ignore end directive (ex. `<!-- dprint-ignore-end -->`). | Default: "dprint-ignore-end"
    "ignoreEndDirective": "dprint-ignore-end",
    // The text to use for an ignore file directive (ex. `<!-- dprint-ignore-file -->`). | Default: "dprint-ignore-file"
    "ignoreFileDirective": "dprint-ignore-file",
    // The text to use for an ignore start directive (ex. `<!-- dprint-ignore-start -->`). | Default: "dprint-ignore-start"
    "ignoreStartDirective": "dprint-ignore-start",
    // The width of a line the printer will try to stay under. Note that the printer may exceed this width in certain cases. | Default: 80
    "lineWidth": 80,
    // The kind of newline to use. | Allowed values: "auto", "crlf", "lf", "system" | Default: "lf"
    "newLineKind": "lf",
    // The character to use for strong emphasis/bold. | Allowed values: "asterisks", "underscores" | Default: "asterisks"
    "strongKind": "asterisks",
    // Text wrapping possibilities. | Allowed values: "always", "maintain", "never" | Default: "maintain"
    "textWrap": "maintain"
  },
}
