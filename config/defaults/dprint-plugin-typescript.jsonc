    "tupleType.preferHanging": "never",
    // If code should revert back from being on multiple lines to being on a single line when able. | Allowed values: true, false | Default: false
    "tupleType.preferSingleLine": false,
    // Whether to place spaces around enclosed expressions. | Allowed values: true, false | Default: false
    "tupleType.spaceAround": false,
    // If trailing commas should be used. | Allowed values: "never", "always", "onlyMultiLine" | Default: "onlyMultiLine"
    "tupleType.trailingCommas": "onlyMultiLine",
    // Whether to add a space before the colon of a type annotation. | Allowed values: true, false | Default: false
    "typeAnnotation.spaceBeforeColon": false,
    // Whether to add a space before the expression in a type assertion. | Allowed values: true, false | Default: true
    "typeAssertion.spaceBeforeExpression": true,
    // Set to prefer hanging indentation when exceeding the line width instead of making code split up on multiple lines. | Allowed values: true, false | Default: false
    "typeLiteral.preferHanging": false,
    // If code should revert back from being on multiple lines to being on a single line when able. | Allowed values: true, false | Default: false
    "typeLiteral.preferSingleLine": false,
    // The kind of separator to use in type literals. | Allowed values: "semiColon", "comma" | Default: "semiColon"
    "typeLiteral.separatorKind": "semiColon",
    // The kind of separator to use in type literals. | Allowed values: "semiColon", "comma" | Default: "semiColon"
    "typeLiteral.separatorKind.multiLine": "semiColon",
    // The kind of separator to use in type literals. | Allowed values: "semiColon", "comma" | Default: "semiColon"
    "typeLiteral.separatorKind.singleLine": "semiColon",
    // Whether to add a space surrounding the properties of a single line type literal. | Allowed values: true, false | Default: true
    "typeLiteral.spaceSurroundingProperties": true,
    // If trailing commas should be used. | Allowed values: "never", "always", "onlyMultiLine" | Default: "onlyMultiLine"
    "typeLiteral.trailingCommas": "onlyMultiLine",
    // Set to prefer hanging indentation when exceeding the line width instead of making code split up on multiple lines. | Allowed values: "always", "onlySingleItem", "never" | Default: "never"
    "typeParameters.preferHanging": "never",
    // If code should revert back from being on multiple lines to being on a single line when able. | Allowed values: true, false | Default: false
    "typeParameters.preferSingleLine": false,
    // If trailing commas should be used. | Allowed values: "never", "always", "onlyMultiLine" | Default: "onlyMultiLine"
    "typeParameters.trailingCommas": "onlyMultiLine",
    // Set to prefer hanging indentation when exceeding the line width instead of making code split up on multiple lines. | Allowed values: true, false | Default: false
    "unionAndIntersectionType.preferHanging": false,
    // If code should revert back from being on multiple lines to being on a single line when able. | Allowed values: true, false | Default: false
    "unionAndIntersectionType.preferSingleLine": false,
    // If braces should be used or not. | Allowed values: "maintain", "whenNotSingleLine", "always", "preferNone" | Default: "whenNotSingleLine"
    "useBraces": "whenNotSingleLine",
    // Whether to use tabs (true) or spaces (false). | Allowed values: true, false | Default: false
    "useTabs": false,
    // Set to prefer hanging indentation when exceeding the line width instead of making code split up on multiple lines. | Allowed values: true, false | Default: false
    "variableStatement.preferHanging": false,
    // If code should revert back from being on multiple lines to being on a single line when able. | Allowed values: true, false | Default: false
    "variableStatement.preferSingleLine": false,
    // Where to place the opening brace. | Allowed values: "maintain", "sameLine", "nextLine", "sameLineUnlessHanging" | Default: "sameLineUnlessHanging"
    "whileStatement.bracePosition": "sameLineUnlessHanging",
    // Set to prefer hanging indentation when exceeding the line width instead of making code split up on multiple lines. | Allowed values: true, false | Default: false
    "whileStatement.preferHanging": false,
    // Where to place the expression of a statement that could possibly be on one line (ex. `if (true) console.log(5);`). | Allowed values: "maintain", "sameLine", "nextLine" | Default: "maintain"
    "whileStatement.singleBodyPosition": "maintain",
    // Whether to add a space after the `while` keyword in a while statement. | Allowed values: true, false | Default: true
    "whileStatement.spaceAfterWhileKeyword": true,
    // Whether to place spaces around enclosed expressions. | Allowed values: true, false | Default: false
    "whileStatement.spaceAround": false,
    // If braces should be used or not. | Allowed values: "maintain", "whenNotSingleLine", "always", "preferNone" | Default: "whenNotSingleLine"
    "whileStatement.useBraces": "whenNotSingleLine"
