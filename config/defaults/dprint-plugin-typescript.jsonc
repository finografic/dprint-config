    "jsxSelfClosingElement.bracketPosition": "nextLine",
    // Whether to add a space before a JSX element's slash when self closing. | Allowed values: true, false | Default: true
    "jsxSelfClosingElement.spaceBeforeSlash": true,
    // The width of a line the printer will try to stay under. Note that the printer may exceed this width in certain cases. | Default: 120
    "lineWidth": 120,
    // If code should revert back from being on multiple lines to being on a single line when able. | Allowed values: true, false | Default: false
    "mappedType.preferSingleLine": false,
    // Whether to force a line per expression when spanning multiple lines. | Allowed values: true, false | Default: false
    "memberExpression.linePerExpression": false,
    // If code should revert back from being on multiple lines to being on a single line when able. | Allowed values: true, false | Default: false
    "memberExpression.preferSingleLine": false,
    // Where to place the opening brace. | Allowed values: "maintain", "sameLine", "nextLine", "sameLineUnlessHanging" | Default: "sameLineUnlessHanging"
    "method.bracePosition": "sameLineUnlessHanging",
    // Whether to add a space before the parentheses of a method. | Allowed values: true, false | Default: false
    "method.spaceBeforeParentheses": false,
    // The kind of sort ordering to use. | Allowed values: "maintain", "caseSensitive", "caseInsensitive" | Default: "caseInsensitive"
    "module.sortExportDeclarations": "caseInsensitive",
    // The kind of sort ordering to use. | Allowed values: "maintain", "caseSensitive", "caseInsensitive" | Default: "caseInsensitive"
    "module.sortImportDeclarations": "caseInsensitive",
    // Where to place the opening brace. | Allowed values: "maintain", "sameLine", "nextLine", "sameLineUnlessHanging" | Default: "sameLineUnlessHanging"
    "moduleDeclaration.bracePosition": "sameLineUnlessHanging",
    // The kind of newline to use. | Allowed values: "auto", "crlf", "lf", "system" | Default: "lf"
    "newLineKind": "lf",
    // Where to place the next control flow within a control flow statement. | Allowed values: "maintain", "sameLine", "nextLine" | Default: "sameLine"
    "nextControlFlowPosition": "sameLine",
    // Set to prefer hanging indentation when exceeding the line width instead of making code split up on multiple lines. | Allowed values: true, false | Default: false
    "objectExpression.preferHanging": false,
    // If code should revert back from being on multiple lines to being on a single line when able. | Allowed values: true, false | Default: false
    "objectExpression.preferSingleLine": false,
    // Whether to add a space surrounding the properties of a single line object expression. | Allowed values: true, false | Default: true
    "objectExpression.spaceSurroundingProperties": true,
    // If trailing commas should be used. | Allowed values: "never", "always", "onlyMultiLine" | Default: "onlyMultiLine"
    "objectExpression.trailingCommas": "onlyMultiLine",
    // Set to prefer hanging indentation when exceeding the line width instead of making code split up on multiple lines. | Allowed values: true, false | Default: false
    "objectPattern.preferHanging": false,
    // If code should revert back from being on multiple lines to being on a single line when able. | Allowed values: true, false | Default: false
    "objectPattern.preferSingleLine": false,
    // Whether to add a space surrounding the properties of a single line object pattern. | Allowed values: true, false | Default: true
    "objectPattern.spaceSurroundingProperties": true,
    // If trailing commas should be used. | Allowed values: "never", "always", "onlyMultiLine" | Default: "onlyMultiLine"
    "objectPattern.trailingCommas": "onlyMultiLine",
    // Where to place the operator for expressions that span multiple lines. | Allowed values: "maintain", "sameLine", "nextLine" | Default: "nextLine"
    "operatorPosition": "nextLine",
    // Set to prefer hanging indentation when exceeding the line width instead of making code split up on multiple lines. | Allowed values: "always", "onlySingleItem", "never" | Default: "never"
    "parameters.preferHanging": "never",
    // If code should revert back from being on multiple lines to being on a single line when able. | Allowed values: true, false | Default: false
    "parameters.preferSingleLine": false,
    // Whether to place spaces around enclosed expressions. | Allowed values: true, false | Default: false
    "parameters.spaceAround": false,
    // If trailing commas should be used. | Allowed values: "never", "always", "onlyMultiLine" | Default: "onlyMultiLine"
    "parameters.trailingCommas": "onlyMultiLine",
    // Whether to place spaces around enclosed expressions. | Allowed values: true, false | Default: false
    "parenExpression.spaceAround": false,
    // If code should revert back from being on multiple lines to being on a single line when able. | Allowed values: true, false | Default: false
    "parentheses.preferSingleLine": false,
    // Set to prefer hanging indentation when exceeding the line width instead of making code split up on multiple lines. | Allowed values: true, false | Default: false
    "preferHanging": false,
    // If code should revert back from being on multiple lines to being on a single line when able. | Allowed values: true, false | Default: false
    "preferSingleLine": false,
    // Change when properties in objects are quoted. | Allowed values: "asNeeded", "consistent", "preserve" | Default: "preserve"
    "quoteProps": "preserve",
    // How to use single or double quotes. | Allowed values: "alwaysDouble", "alwaysSingle", "preferDouble", "preferSingle" | Default: "alwaysDouble"
    "quoteStyle": "alwaysDouble",
    // How semi-colons should be used. | Allowed values: "always", "prefer", "asi" | Default: "prefer"
    "semiColons": "prefer",
