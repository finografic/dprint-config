{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "typescript": {
    // Set to prefer hanging indentation when exceeding the line width instead of making code split up on multiple lines. | Allowed values: "always", "onlySingleItem", "never" | Default: "never"
    "arguments.preferHanging": "never",
    // If code should revert back from being on multiple lines to being on a single line when able. | Allowed values: true, false | Default: false
    "arguments.preferSingleLine": false,
    // Whether to place spaces around enclosed expressions. | Allowed values: true, false | Default: false
    "arguments.spaceAround": false,
    // If trailing commas should be used. | Allowed values: "never", "always", "onlyMultiLine" | Default: "onlyMultiLine"
    "arguments.trailingCommas": "onlyMultiLine",
    // Set to prefer hanging indentation when exceeding the line width instead of making code split up on multiple lines. | Allowed values: "always", "onlySingleItem", "never" | Default: "never"
    "arrayExpression.preferHanging": "never",
    // If code should revert back from being on multiple lines to being on a single line when able. | Allowed values: true, false | Default: false
    "arrayExpression.preferSingleLine": false,
    // Whether to place spaces around enclosed expressions. | Allowed values: true, false | Default: false
    "arrayExpression.spaceAround": false,
    // If trailing commas should be used. | Allowed values: "never", "always", "onlyMultiLine" | Default: "onlyMultiLine"
    "arrayExpression.trailingCommas": "onlyMultiLine",
    // Set to prefer hanging indentation when exceeding the line width instead of making code split up on multiple lines. | Allowed values: true, false | Default: false
    "arrayPattern.preferHanging": false,
    // If code should revert back from being on multiple lines to being on a single line when able. | Allowed values: true, false | Default: false
    "arrayPattern.preferSingleLine": false,
    // Whether to place spaces around enclosed expressions. | Allowed values: true, false | Default: false
    "arrayPattern.spaceAround": false,
    // If trailing commas should be used. | Allowed values: "never", "always", "onlyMultiLine" | Default: "onlyMultiLine"
    "arrayPattern.trailingCommas": "onlyMultiLine",
    // Where to place the opening brace. | Allowed values: "maintain", "sameLine", "nextLine", "sameLineUnlessHanging" | Default: "sameLineUnlessHanging"
    "arrowFunction.bracePosition": "sameLineUnlessHanging",
    // Whether to use parentheses around a single parameter in an arrow function. | Allowed values: "force", "maintain", "preferNone" | Default: "maintain"
    "arrowFunction.useParentheses": "maintain",
    // Whether to force a line per expression when spanning multiple lines. | Allowed values: true, false | Default: false
    "binaryExpression.linePerExpression": false,
    // Where to place the operator for expressions that span multiple lines. | Allowed values: "maintain", "sameLine", "nextLine" | Default: "nextLine"
    "binaryExpression.operatorPosition": "nextLine",
    // If code should revert back from being on multiple lines to being on a single line when able. | Allowed values: true, false | Default: false
    "binaryExpression.preferSingleLine": false,
    // Whether to surround the operator in a binary expression with spaces. | Allowed values: true, false | Default: true
    "binaryExpression.spaceSurroundingBitwiseAndArithmeticOperator": true,
    // Where to place the opening brace. | Allowed values: "maintain", "sameLine", "nextLine", "sameLineUnlessHanging" | Default: "sameLineUnlessHanging"
    "bracePosition": "sameLineUnlessHanging",
    // Whether to place spaces around enclosed expressions. | Allowed values: true, false | Default: false
    "catchClause.spaceAround": false,
    // Where to place the opening brace. | Allowed values: "maintain", "sameLine", "nextLine", "sameLineUnlessHanging" | Default: "sameLineUnlessHanging"
    "classDeclaration.bracePosition": "sameLineUnlessHanging",
    // Where to place the opening brace. | Allowed values: "maintain", "sameLine", "nextLine", "sameLineUnlessHanging" | Default: "sameLineUnlessHanging"
    "classExpression.bracePosition": "sameLineUnlessHanging",
    // Forces a space after the double slash in a comment line. | Allowed values: true, false | Default: true
    "commentLine.forceSpaceAfterSlashes": true,
    // If code should revert back from being on multiple lines to being on a single line when able. | Allowed values: true, false | Default: false
    "computed.preferSingleLine": false,
    // Where to place the operator for expressions that span multiple lines. | Allowed values: "maintain", "sameLine", "nextLine" | Default: "nextLine"
    "conditionalExpression.operatorPosition": "nextLine",
    // If code should revert back from being on multiple lines to being on a single line when able. | Allowed values: true, false | Default: false
    "conditionalExpression.preferSingleLine": false,
    // Where to place the operator for expressions that span multiple lines. | Allowed values: "maintain", "sameLine", "nextLine" | Default: "nextLine"
    "conditionalType.operatorPosition": "nextLine",
    // If code should revert back from being on multiple lines to being on a single line when able. | Allowed values: true, false | Default: false
    "conditionalType.preferSingleLine": false,
    // Where to place the opening brace. | Allowed values: "maintain", "sameLine", "nextLine", "sameLineUnlessHanging" | Default: "sameLineUnlessHanging"
    "constructor.bracePosition": "sameLineUnlessHanging",
    // Whether to add a space before the parentheses of a constructor. | Allowed values: true, false | Default: false
    "constructor.spaceBeforeParentheses": false,
    // Whether to add a space after the `new` keyword in a constructor type. | Allowed values: true, false | Default: false
    "constructorType.spaceAfterNewKeyword": false,
    // Whether to add a space after the `new` keyword in a construct signature. | Allowed values: true, false | Default: false
    "constructSignature.spaceAfterNewKeyword": false,
    // If code should revert back from being on multiple lines to being on a single line when able. | Allowed values: true, false | Default: false
    "decorators.preferSingleLine": false,
    // Top level configuration that sets the configuration to what is used in Deno. | Allowed values: true, false | Default: false
    "deno": false,
    // Where to place the opening brace. | Allowed values: "maintain", "sameLine", "nextLine", "sameLineUnlessHanging" | Default: "sameLineUnlessHanging"
    "doWhileStatement.bracePosition": "sameLineUnlessHanging",
    // Where to place the next control flow within a control flow statement. | Allowed values: "maintain", "sameLine", "nextLine" | Default: "sameLine"
    "doWhileStatement.nextControlFlowPosition": "sameLine",
    // Set to prefer hanging indentation when exceeding the line width instead of making code split up on multiple lines. | Allowed values: true, false | Default: false
    "doWhileStatement.preferHanging": false,
    // Whether to add a space after the `while` keyword in a do while statement. | Allowed values: true, false | Default: true
    "doWhileStatement.spaceAfterWhileKeyword": true,
    // Whether to place spaces around enclosed expressions. | Allowed values: true, false | Default: false
    "doWhileStatement.spaceAround": false,
    // Where to place the opening brace. | Allowed values: "maintain", "sameLine", "nextLine", "sameLineUnlessHanging" | Default: "sameLineUnlessHanging"
    "enumDeclaration.bracePosition": "sameLineUnlessHanging",
    // How to space the members of an enum. | Allowed values: "newLine", "blankLine", "maintain" | Default: "maintain"
    "enumDeclaration.memberSpacing": "maintain",
    // If trailing commas should be used. | Allowed values: "never", "always", "onlyMultiLine" | Default: "onlyMultiLine"
    "enumDeclaration.trailingCommas": "onlyMultiLine",
    // If code import/export specifiers should be forced to be on multiple lines. | Allowed values: "always", "never", "whenMultiple" | Default: "never"
    "exportDeclaration.forceMultiLine": "never",
    // If code should be forced to be on a single line if able. | Allowed values: true, false | Default: false
    "exportDeclaration.forceSingleLine": false,
    // Set to prefer hanging indentation when exceeding the line width instead of making code split up on multiple lines. | Allowed values: true, false | Default: false
    "exportDeclaration.preferHanging": false,
    // If code should revert back from being on multiple lines to being on a single line when able. | Allowed values: true, false | Default: false
    "exportDeclaration.preferSingleLine": false,
    // The kind of sort ordering to use. | Allowed values: "maintain", "caseSensitive", "caseInsensitive" | Default: "caseInsensitive"
    "exportDeclaration.sortNamedExports": "caseInsensitive",
    // The kind of sort ordering to use for typed imports and exports. | Allowed values: "first", "last", "none" | Default: "none"
    "exportDeclaration.sortTypeOnlyExports": "none",
    // Whether to add spaces around named exports in an export declaration. | Allowed values: true, false | Default: true
    "exportDeclaration.spaceSurroundingNamedExports": true,
    // If trailing commas should be used. | Allowed values: "never", "always", "onlyMultiLine" | Default: "onlyMultiLine"
    "exportDeclaration.trailingCommas": "onlyMultiLine",
    // Set to prefer hanging indentation when exceeding the line width instead of making code split up on multiple lines. | Allowed values: true, false | Default: false
    "extendsClause.preferHanging": false,
    // Where to place the opening brace. | Allowed values: "maintain", "sameLine", "nextLine", "sameLineUnlessHanging" | Default: "sameLineUnlessHanging"
    "forInStatement.bracePosition": "sameLineUnlessHanging",
    // Set to prefer hanging indentation when exceeding the line width instead of making code split up on multiple lines. | Allowed values: true, false | Default: false
    "forInStatement.preferHanging": false,
    // Where to place the expression of a statement that could possibly be on one line (ex. `if (true) console.log(5);`). | Allowed values: "maintain", "sameLine", "nextLine" | Default: "maintain"
    "forInStatement.singleBodyPosition": "maintain",
    // Whether to add a space after the `for` keyword in a "for in" statement. | Allowed values: true, false | Default: true
    "forInStatement.spaceAfterForKeyword": true,
    // Whether to place spaces around enclosed expressions. | Allowed values: true, false | Default: false
    "forInStatement.spaceAround": false,
    // If braces should be used or not. | Allowed values: "maintain", "whenNotSingleLine", "always", "preferNone" | Default: "whenNotSingleLine"
    "forInStatement.useBraces": "whenNotSingleLine",
    // Where to place the opening brace. | Allowed values: "maintain", "sameLine", "nextLine", "sameLineUnlessHanging" | Default: "sameLineUnlessHanging"
    "forOfStatement.bracePosition": "sameLineUnlessHanging",
    // Set to prefer hanging indentation when exceeding the line width instead of making code split up on multiple lines. | Allowed values: true, false | Default: false
    "forOfStatement.preferHanging": false,
    // Where to place the expression of a statement that could possibly be on one line (ex. `if (true) console.log(5);`). | Allowed values: "maintain", "sameLine", "nextLine" | Default: "maintain"
    "forOfStatement.singleBodyPosition": "maintain",
    // Whether to add a space after the `for` keyword in a "for of" statement. | Allowed values: true, false | Default: true
    "forOfStatement.spaceAfterForKeyword": true,
    // Whether to place spaces around enclosed expressions. | Allowed values: true, false | Default: false
    "forOfStatement.spaceAround": false,
    // If braces should be used or not. | Allowed values: "maintain", "whenNotSingleLine", "always", "preferNone" | Default: "whenNotSingleLine"
    "forOfStatement.useBraces": "whenNotSingleLine",
    // Where to place the opening brace. | Allowed values: "maintain", "sameLine", "nextLine", "sameLineUnlessHanging" | Default: "sameLineUnlessHanging"
    "forStatement.bracePosition": "sameLineUnlessHanging",
    // Set to prefer hanging indentation when exceeding the line width instead of making code split up on multiple lines. | Allowed values: true, false | Default: false
    "forStatement.preferHanging": false,
    // If code should revert back from being on multiple lines to being on a single line when able. | Allowed values: true, false | Default: false
    "forStatement.preferSingleLine": false,
    // Where to place the expression of a statement that could possibly be on one line (ex. `if (true) console.log(5);`). | Allowed values: "maintain", "sameLine", "nextLine" | Default: "maintain"
    "forStatement.singleBodyPosition": "maintain",
    // Whether to add a space after the `for` keyword in a "for" statement. | Allowed values: true, false | Default: true
    "forStatement.spaceAfterForKeyword": true,
    // Whether to add a space after the semi-colons in a "for" statement. | Allowed values: true, false | Default: true
    "forStatement.spaceAfterSemiColons": true,
    // Whether to place spaces around enclosed expressions. | Allowed values: true, false | Default: false
    "forStatement.spaceAround": false,
    // If braces should be used or not. | Allowed values: "maintain", "whenNotSingleLine", "always", "preferNone" | Default: "whenNotSingleLine"
    "forStatement.useBraces": "whenNotSingleLine",
    // Where to place the opening brace. | Allowed values: "maintain", "sameLine", "nextLine", "sameLineUnlessHanging" | Default: "sameLineUnlessHanging"
    "functionDeclaration.bracePosition": "sameLineUnlessHanging",
    // Whether to add a space before the parentheses of a function declaration. | Allowed values: true, false | Default: false
    "functionDeclaration.spaceBeforeParentheses": false,
    // Where to place the opening brace. | Allowed values: "maintain", "sameLine", "nextLine", "sameLineUnlessHanging" | Default: "sameLineUnlessHanging"
    "functionExpression.bracePosition": "sameLineUnlessHanging",
    // Whether to add a space after the function keyword of a function expression. | Allowed values: true, false | Default: false
    "functionExpression.spaceAfterFunctionKeyword": false,
    // Whether to add a space before the parentheses of a function expression. | Allowed values: true, false | Default: false
    "functionExpression.spaceBeforeParentheses": false,
    // Where to place the opening brace. | Allowed values: "maintain", "sameLine", "nextLine", "sameLineUnlessHanging" | Default: "sameLineUnlessHanging"
    "getAccessor.bracePosition": "sameLineUnlessHanging",
    // Whether to add a space before the parentheses of a get accessor. | Allowed values: true, false | Default: false
    "getAccessor.spaceBeforeParentheses": false,
    // Where to place the opening brace. | Allowed values: "maintain", "sameLine", "nextLine", "sameLineUnlessHanging" | Default: "sameLineUnlessHanging"
    "ifStatement.bracePosition": "sameLineUnlessHanging",
    // Where to place the next control flow within a control flow statement. | Allowed values: "maintain", "sameLine", "nextLine" | Default: "sameLine"
    "ifStatement.nextControlFlowPosition": "sameLine",
    // Set to prefer hanging indentation when exceeding the line width instead of making code split up on multiple lines. | Allowed values: true, false | Default: false
    "ifStatement.preferHanging": false,
    // Where to place the expression of a statement that could possibly be on one line (ex. `if (true) console.log(5);`). | Allowed values: "maintain", "sameLine", "nextLine" | Default: "maintain"
    "ifStatement.singleBodyPosition": "maintain",
    // Whether to add a space after the `if` keyword in an "if" statement. | Allowed values: true, false | Default: true
    "ifStatement.spaceAfterIfKeyword": true,
    // Whether to place spaces around enclosed expressions. | Allowed values: true, false | Default: false
    "ifStatement.spaceAround": false,
    // If braces should be used or not. | Allowed values: "maintain", "whenNotSingleLine", "always", "preferNone" | Default: "whenNotSingleLine"
    "ifStatement.useBraces": "whenNotSingleLine",
    // The text to use for a file ignore comment (ex. `// dprint-ignore-file`). | Default: "dprint-ignore-file"
    "ignoreFileCommentText": "dprint-ignore-file",
    // The text to use for an ignore comment (ex. `// dprint-ignore`). | Default: "dprint-ignore"
    "ignoreNodeCommentText": "dprint-ignore",
    // Set to prefer hanging indentation when exceeding the line width instead of making code split up on multiple lines. | Allowed values: true, false | Default: false
    "implementsClause.preferHanging": false,
    // If code import/export specifiers should be forced to be on multiple lines. | Allowed values: "always", "never", "whenMultiple" | Default: "never"
    "importDeclaration.forceMultiLine": "never",
    // If code should be forced to be on a single line if able. | Allowed values: true, false | Default: false
    "importDeclaration.forceSingleLine": false,
    // Set to prefer hanging indentation when exceeding the line width instead of making code split up on multiple lines. | Allowed values: true, false | Default: false
    "importDeclaration.preferHanging": false,
    // If code should revert back from being on multiple lines to being on a single line when able. | Allowed values: true, false | Default: false
    "importDeclaration.preferSingleLine": false,
    // The kind of sort ordering to use. | Allowed values: "maintain", "caseSensitive", "caseInsensitive" | Default: "caseInsensitive"
    "importDeclaration.sortNamedImports": "caseInsensitive",
    // The kind of sort ordering to use for typed imports and exports. | Allowed values: "first", "last", "none" | Default: "none"
    "importDeclaration.sortTypeOnlyImports": "none",
    // Whether to add spaces around named imports in an import declaration. | Allowed values: true, false | Default: true
    "importDeclaration.spaceSurroundingNamedImports": true,
    // If trailing commas should be used. | Allowed values: "never", "always", "onlyMultiLine" | Default: "onlyMultiLine"
    "importDeclaration.trailingCommas": "onlyMultiLine",
    // The number of columns for an indent. | Default: 2
    "indentWidth": 2,
    // Where to place the opening brace. | Allowed values: "maintain", "sameLine", "nextLine", "sameLineUnlessHanging" | Default: "sameLineUnlessHanging"
    "interfaceDeclaration.bracePosition": "sameLineUnlessHanging",
    // If the end angle bracket of a jsx open element or self closing element should be on the same or next line when the attributes span multiple lines. | Allowed values: "maintain", "sameLine", "nextLine" | Default: "nextLine"
    "jsx.bracketPosition": "nextLine",
    // Forces newlines surrounding the content of JSX elements. | Allowed values: true, false | Default: false
    "jsx.forceNewLinesSurroundingContent": false,
    // Surrounds the top-most JSX element or fragment in parentheses when it spans multiple lines. | Allowed values: "never", "prefer", "always" | Default: "prefer"
    "jsx.multiLineParens": "prefer",
    // How to use single or double quotes in JSX attributes. | Allowed values: "preferDouble", "preferSingle" | Default: "preferDouble"
    "jsx.quoteStyle": "preferDouble",
    // Set to prefer hanging indentation when exceeding the line width instead of making code split up on multiple lines. | Allowed values: true, false | Default: false
    "jsxAttributes.preferHanging": false,
    // If code should revert back from being on multiple lines to being on a single line when able. | Allowed values: true, false | Default: false
    "jsxAttributes.preferSingleLine": false,
    // If code should revert back from being on multiple lines to being on a single line when able. | Allowed values: true, false | Default: false
    "jsxElement.preferSingleLine": false,
    // Whether to add a space surrounding the expression of a JSX container. | Allowed values: true, false | Default: false
    "jsxExpressionContainer.spaceSurroundingExpression": false,
    // If the end angle bracket of a jsx open element or self closing element should be on the same or next line when the attributes span multiple lines. | Allowed values: "maintain", "sameLine", "nextLine" | Default: "nextLine"
    "jsxOpeningElement.bracketPosition": "nextLine",
