{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "json": {
    "indentWidth": 2,
    "useTabs": false,
    "trailingCommas": "jsonc",
    // Handle both .json and .jsonc files
    "associations": [
      "**/*.json",
      "**/*.jsonc",
      ".eslintrc.json",
      "dprint.jsonc",
    ],
  },
  "plugins": [
    "https://plugins.dprint.dev/json-0.21.1.wasm",
  ],
}
