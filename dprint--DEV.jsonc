{
  "$schema": "https://dprint.dev/schemas/v0.json",
  // Global formatting settings - aligned with @finografic/eslint-config
  "lineWidth": 100,
  "indentWidth": 2,
  "useTabs": false,
  "newLineKind": "lf",
  "typescript": {
    "semiColons": "always",
    "quoteStyle": "preferSingle",
    "quoteProps": "asNeeded",
    "trailingCommas": "always",
    "arrowFunction.useParentheses": "force",
    "preferHanging": false,
    "preferSingleLine": false,
    "bracePosition": "sameLine",
    "singleBodyPosition": "maintain",
    "nextControlFlowPosition": "sameLine",
    "operatorPosition": "nextLine",
    "conditionalExpression.operatorPosition": "nextLine",
    "binaryExpression.operatorPosition": "nextLine",
    "jsx.quoteStyle": "preferDouble",
    "jsx.bracePosition": "sameLine",
    "jsx.braceSpacing": true,
    "jsx.multiLineParens": "prefer",
    "jsx.selfClosingSpace": true,
    "module.sortExportDeclarations": "caseInsensitive",
    "module.sortImportDeclarations": "caseInsensitive",
    "typeLiteral.separatorKind": "semicolon",
    "typeLiteral.singleLine": "forceMaintainSingleLine",
    "enumDeclaration.memberSpacing": "newline",
    "functionExpression.arrow": "preferWhenPossible",
    "preferFunctionDeclarations": false,
    "objectExpression.preferSingleLine": false,
    "arrayExpression.preferSingleLine": false,
    "arrayPattern.preferSingleLine": false,
    "objectPattern.preferSingleLine": false,
    "callExpression.preferSingleLine": false,
    "memberExpression.preferSingleLine": false,
    "binaryExpression.preferSingleLine": false,
    "conditionalExpression.preferSingleLine": false,
    "taggedTemplate.preferSingleLine": false,
    "forStatement.preferSingleLine": false,
    "ifStatement.preferSingleLine": false,
    "whileStatement.preferSingleLine": false,
    "switchStatement.preferSingleLine": false,
    "tryStatement.preferSingleLine": false,
  },
  "json": {
    "indentWidth": 2,
    "lineWidth": 100,
    "useTabs": false,
    "trailingCommas": false,
    "commentLine": "preserve",
    "commentIndent": "preserve",
  },
  "markdown": {
    "textWrap": "preserve",
    "lineWidth": 100,
    "emphasisKind": "asterisk",
    "strongKind": "asterisk",
    "bulletKind": "asterisk",
    "bulletMarkerOne": "*",
    "bulletMarkerTwo": "*",
    "bulletMarkerThree": "*",
    "orderedListStyle": "ordered",
    "codeBlockStyle": "fenced",
    "fenceStyle": "backtick",
    "codeBlockTextStyle": "preserve",
    "codeBlockTextWrap": "preserve",
    "emphasisSpaces": false,
    "strongSpaces": false,
    "hardBreaks": false,
    "linkReferenceKind": "shortcut",
    "linkReferenceStyle": "full",
    "textWrapPreserveSingleLineLinks": true,
  },
  "toml": {
    "indentWidth": 2,
    "lineWidth": 100,
    "useTabs": false,
    "trailingCommas": false,
    "arrayTrailingCommas": false,
    "inlineArraySpacing": false,
    "inlineTableSpacing": false,
    "keyValuePairSpacing": "space",
    "tableBracketSpacing": false,
    "arrayBracketSpacing": false,
  },
  "yaml": {
    "indentWidth": 2,
    "lineWidth": 100,
    "useTabs": false,
    "quoteStyle": "preferSingle",
    "quoteKeys": "onlyWhenNeeded",
    "lineEnding": "lf",
    "arrayPosition": "auto",
    "arrayBracketSpacing": false,
    "arrayTrailingCommas": false,
    "objectPosition": "auto",
    "objectBracketSpacing": false,
    "objectTrailingCommas": false,
  },
  "malva": {
    "indentWidth": 2,
    "lineWidth": 100,
    "useTabs": false,
    "quoteStyle": "double",
    "semicolons": "always",
    "trailingCommas": "always",
    "bracePosition": "sameLine",
    "arrowFunction.useParentheses": "force",
    "selectorBracePosition": "sameLine",
    "atRuleBracePosition": "sameLine",
    "atRuleNoSpace": false,
    "atRuleSpace": true,
    "combinatorSpace": true,
    "propertyColonSpace": true,
    "propertySemicolonSpace": true,
    "selectorCombinatorSpace": true,
    "selectorCombinatorNewline": false,
    "selectorAttributeSpace": true,
    "selectorPseudoClassSpace": true,
    "selectorPseudoElementSpace": true,
    "mediaQueryListCommaSpace": true,
    "mediaQueryListCommaNewline": false,
    "functionCommaSpace": true,
    "functionCommaNewline": false,
    "functionSpace": true,
    "valueCommaSpace": true,
    "valueCommaNewline": false,
    "valueSpace": true,
    "valueOperatorSpace": true,
    "valueParenSpace": false,
    "valueParenNewline": false,
    "valueListCommaSpace": true,
    "valueListCommaNewline": false,
    "declarationColonSpace": true,
    "declarationSemicolonSpace": true,
    "declarationBraceSpace": false,
    "declarationBraceNewline": false,
    "ruleBraceSpace": false,
    "ruleBraceNewline": false,
    "ruleSelectorCommaSpace": true,
    "ruleSelectorCommaNewline": false,
    "ruleSelectorSpace": true,
    "ruleSelectorNewline": false,
    "atRuleBraceSpace": false,
    "atRuleBraceNewline": false,
    "atRuleNameSpace": true,
    "atRuleNameNewline": false,
    "atRuleParamsSpace": true,
    "atRuleParamsNewline": false,
    "atRuleSemicolonSpace": true,
    "atRuleSemicolonNewline": false,
    "mediaQueryBraceSpace": false,
    "mediaQueryBraceNewline": false,
    "mediaQueryCommaSpace": true,
    "mediaQueryCommaNewline": false,
    "mediaQueryAndSpace": true,
    "mediaQueryAndNewline": false,
    "mediaQueryFeatureColonSpace": true,
    "mediaQueryFeatureColonNewline": false,
    "mediaQueryFeatureParenSpace": false,
    "mediaQueryFeatureParenNewline": false,
    "mediaQueryFeatureOperatorSpace": true,
    "mediaQueryFeatureOperatorNewline": false,
    "mediaQueryFeatureValueSpace": true,
    "mediaQueryFeatureValueNewline": false,
    "mediaQueryRangeOperatorSpace": true,
    "mediaQueryRangeOperatorNewline": false,
    "supportsBraceSpace": false,
    "supportsBraceNewline": false,
    "supportsConditionSpace": true,
    "supportsConditionNewline": false,
    "supportsFeatureColonSpace": true,
    "supportsFeatureColonNewline": false,
    "supportsFeatureParenSpace": false,
    "supportsFeatureParenNewline": false,
    "supportsFeatureOperatorSpace": true,
    "supportsFeatureOperatorNewline": false,
    "supportsFeatureValueSpace": true,
    "supportsFeatureValueNewline": false,
    "keyframesBraceSpace": false,
    "keyframesBraceNewline": false,
    "keyframesSelectorSpace": true,
    "keyframesSelectorNewline": false,
    "keyframesDeclarationColonSpace": true,
    "keyframesDeclarationColonNewline": false,
    "keyframesDeclarationSemicolonSpace": true,
    "keyframesDeclarationSemicolonNewline": false,
    "pageBraceSpace": false,
    "pageBraceNewline": false,
    "pageSelectorSpace": true,
    "pageSelectorNewline": false,
    "pageDeclarationColonSpace": true,
    "pageDeclarationColonNewline": false,
    "pageDeclarationSemicolonSpace": true,
    "pageDeclarationSemicolonNewline": false,
    "fontFaceBraceSpace": false,
    "fontFaceBraceNewline": false,
    "fontFaceDeclarationColonSpace": true,
    "fontFaceDeclarationColonNewline": false,
    "fontFaceDeclarationSemicolonSpace": true,
    "fontFaceDeclarationSemicolonNewline": false,
    "importBraceSpace": false,
    "importBraceNewline": false,
    "importUrlSpace": true,
    "importUrlNewline": false,
    "importMediaSpace": true,
    "importMediaNewline": false,
    "namespaceBraceSpace": false,
    "namespaceBraceNewline": false,
    "namespacePrefixSpace": true,
    "namespacePrefixNewline": false,
    "namespaceUrlSpace": true,
    "namespaceUrlNewline": false,
    "charsetSpace": true,
    "charsetNewline": false,
    "viewportSpace": true,
    "viewportNewline": false,
    "containerBraceSpace": false,
    "containerBraceNewline": false,
    "containerNameSpace": true,
    "containerNameNewline": false,
    "containerTypeSpace": true,
    "containerTypeNewline": false,
    "containerQueryBraceSpace": false,
    "containerQueryBraceNewline": false,
    "containerQueryCommaSpace": true,
    "containerQueryCommaNewline": false,
    "containerQueryAndSpace": true,
    "containerQueryAndNewline": false,
    "containerQueryFeatureColonSpace": true,
    "containerQueryFeatureColonNewline": false,
    "containerQueryFeatureParenSpace": false,
    "containerQueryFeatureParenNewline": false,
    "containerQueryFeatureOperatorSpace": true,
    "containerQueryFeatureOperatorNewline": false,
    "containerQueryFeatureValueSpace": true,
    "containerQueryFeatureValueNewline": false,
    "layerBraceSpace": false,
    "layerBraceNewline": false,
    "layerNameSpace": true,
    "layerNameNewline": false,
    "scopeBraceSpace": false,
    "scopeBraceNewline": false,
    "scopeStartSpace": true,
    "scopeStartNewline": false,
    "scopeEndSpace": true,
    "scopeEndNewline": false,
    "startingPositionBraceSpace": false,
    "startingPositionBraceNewline": false,
    "startingPositionSelectorSpace": true,
    "startingPositionSelectorNewline": false,
    "nestingBraceSpace": false,
    "nestingBraceNewline": false,
    "nestingSelectorSpace": true,
    "nestingSelectorNewline": false,
  },
}
