{
  "$schema": "https://dprint.dev/schemas/v0.json",
  // JSON-specific configuration
  "json": {
    "indentWidth": 2,
    "lineWidth": 100,
    "useTabs": false,
    "associations": [
      ".eslintrc.json",
      "dprint.jsonc"
    ]
  },
  "plugins": [
    "https://plugins.dprint.dev/json-0.21.1.wasm"
  ]
}
