{
  // REF: CONFIGURATION DOCUMENTATION:
  // https://dprint.dev/config/
  "$schema": "https://dprint.dev/schemas/v0.json",
  "extends": [
    "./dprint-json.jsonc",
    "./dprint-typescript.jsonc",
    "./dprint-markdown.jsonc",
    "./dprint-toml.jsonc",
    "./dprint-yaml.jsonc",
    "./dprint-malva.jsonc",
    "./dprint-markup.jsonc",
  ],
  "lineWidth": 100,
  "indentWidth": 2,
  "useTabs": false,
  "newLineKind": "lf",
  "excludes": [
    "**/node_modules",
    "**/*-lock.json",
  ],
}
