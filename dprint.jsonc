{
  // REF: CONFIGURATION DOCUMENTATION:
  // https://dprint.dev/config/
  "$schema": "https://dprint.dev/schemas/v0.json",
  "extends": [
    "./configs/dprint-plugin-typescript.jsonc",
    "./configs/dprint-plugin-json.jsonc",
    "./configs/dprint-plugin-markdown.jsonc",
    "./configs/dprint-plugin-toml.jsonc",
    "./configs/malva.jsonc",
    "./configs/markup_fmt.jsonc",
    "./configs/pretty_yaml.jsonc",
  ],
  "lineWidth": 100,
  "indentWidth": 2,
  "useTabs": false,
  "newLineKind": "lf",
  "excludes": [
    "**/node_modules",
    "**/*-lock.json",
    "**/*-lock.yaml",
    "**/*.d.ts",
    "docs/**/*.rules.md",
    "schemas/**/*.json",
  ],
}
