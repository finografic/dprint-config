{
  "name": "@finografic/dprint-config",
  "version": "0.8.0",
  "description": "Opinionated dprint configuration for the finografic ecosystem",
  "license": "MIT",
  "homepage": "https://github.com/finografic/dprint-config",
  "repository": {
    "type": "git",
    "url": "https://github.com/finografic/dprint-config.git"
  },
  "bugs": {
    "url": "https://github.com/finografic/dprint-config/issues"
  },
  "keywords": [
    "dprint",
    "dprint-config",
    "formatter",
    "finografic"
  ],
  "files": [
    "dprint.jsonc",
    "configs/overrides/*.jsonc",
    "configs/plugins.registry.ts",
    "docs/**/*.md",
    "internal/schemas/*.json",
    "types/*.d.ts",
    "README.md"
  ],
  "scripts": {
    "========== LINTING": "===================================================",
    "lint": "eslint .",
    "lint.fix": "eslint . --fix",
    "·········· FORMATTING": "················································",
    "format": "dprint fmt --diff",
    "format.check": "dprint check",
    "·········· DPRINT COMMANDS": "···········································",
    "dprint.plugins.update": "tsx ./scripts/update-plugins.ts",
    "rules.generate": "tsx ./scripts/generate-rules.ts",
    "home.config.generate": "tsx ./scripts/generate-home-config.ts",
    "home.config.install": "tsx ./scripts/generate-home-config.ts --install",
    "·········· PUBLISH.GITHUB": "············································",
    "release.github.patch": "pnpm run release.check && pnpm version patch && git push --follow-tags",
    "release.github.minor": "pnpm run release.check && pnpm version minor && git push --follow-tags",
    "release.github.major": "pnpm run release.check && pnpm version major && git push --follow-tags",
    "release.check": "pnpm lint.fix",
    "·········· REGISTRIES": "················································",
    "view.registry.github": "pnpm view @finografic/dprint-config --registry=https://npm.pkg.github.com",
    "·········· PACKAGES": "··················································",
    "upgrade.deps.all": "pnpm update --latest",
    "·········· HOOKS": "·····················································",
    "prepare": "simple-git-hooks"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "eslint --fix"
    ],
    "*.md": [
      "eslint --fix"
    ]
  },
  "peerDependencies": {
    "dprint": "^0.51.1"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.2",
    "jiti": "^2.6.1",
    "lint-staged": "^16.2.7",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0"
  }
}
