{
  "compilerOptions": {
    "target": "esnext",
    "lib": [
      "es2023"
    ],
    "types": [
      "node"
    ],
    "moduleDetection": "force",
    "module": "preserve",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "configs/*": ["./configs/*"],
      "docs/*": ["./docs/*"],
      "scripts/*": ["./scripts/*"],
      "schemas/*": ["./schemas/*"],
      "types/*": ["./types/*"]
    }
  },
  "include": [
    "eslint.config.ts",
    "*.mjs",
    "*.ts",
    "configs/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
